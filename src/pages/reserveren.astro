---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Reserveren | ${site.name}`} description="Reserveren bij Turuncu? Neem telefonisch contact met ons op of stuur ons een bericht via Instagram.">
  <main id="main-content" class="route-placeholder section" tabindex="-1">
    <div class="container">
      <p class="eyebrow">Turuncu</p>
      <h1>Reserveren</h1>
      <p class="intro">Online reserveren wordt later mogelijk.</p>
      <p>{site.reservationMessage}</p>
      <div class="button-group">
        <a class="button button-primary" href={site.phoneHref}>Bel ons</a>
        <a class="button button-secondary" href={site.instagram.href}>Instagram</a>
        <a class="button button-secondary" href="/#contact">Naar contact</a>
      </div>
      <p class="reservation-details">{site.phone}<br />Instagram: {site.instagram.handle}</p>
    </div>
  </main>
</BaseLayout>

<style>
  .reservation-details { margin-top: var(--space-3); color: var(--color-muted); }
</style>
