---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const desiredTimes = Array.from({ length: 13 }, (_, index) => {
  const minutes = 10 * 60 + index * 30;
  return `${String(Math.floor(minutes / 60)).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`;
});
---

<BaseLayout title={`Reserveren | ${site.name}`} description="Stuur online een reserveringsaanvraag naar Turuncu Café en Bakkerij in Gouda. Een aanvraag is definitief nadat Turuncu deze heeft bevestigd." canonicalPath="/reserveren">
  <main id="main-content" class="reservation-page section" tabindex="-1">
    <div class="container reservation-container">
      <header class="reservation-intro">
        <p class="eyebrow">Een tafel bij Turuncu</p>
        <h1>Reserveren</h1>
        <p class="intro">Wil je een tafel reserveren bij Turuncu? Vul het formulier in en stuur je reserveringsaanvraag.</p>
        <p>Je reservering is pas definitief nadat Turuncu deze heeft bevestigd.</p>
      </header>
      <div data-reservation-widget>
        <form action="/api/reservations" method="post" data-reservation-form>
          <p class="form-required">Velden met een * zijn verplicht.</p>
          <p class="form-error" data-form-error role="alert" tabindex="-1" hidden></p>
          <fieldset data-form-fields disabled>
            <legend class="sr-only">Je reserveringsaanvraag</legend>
            <div class="reservation-grid reservation-visit">
              <div class="reservation-field">
                <label for="reservation-date">Datum *</label>
                <input id="reservation-date" name="reservationDate" type="date" required aria-describedby="reservation-date-help reservationDate-error" />
                <p id="reservation-date-help" class="field-help">Dinsdag t/m zaterdag.</p>
                <p id="reservationDate-error" class="field-error" data-error-for="reservationDate" aria-live="polite" hidden></p>
              </div>
              <div class="reservation-field">
                <label for="reservation-time">Gewenste tijd *</label>
                <select id="reservation-time" name="reservationTime" required aria-describedby="reservation-time-help reservationTime-error">
                  <option value="">Kies een tijd</option>
                  {desiredTimes.map((time) => <option value={time}>{time}</option>)}
                </select>
                <p id="reservation-time-help" class="field-help">Een voorkeur, geen garantie op een tafel.</p>
                <p id="reservationTime-error" class="field-error" data-error-for="reservationTime" hidden></p>
              </div>
              <div class="reservation-field">
                <label for="reservation-guests">Aantal personen *</label>
                <input id="reservation-guests" name="guestCount" type="number" min="1" step="1" required inputmode="numeric" aria-describedby="guestCount-error" />
                <p id="guestCount-error" class="field-error" data-error-for="guestCount" hidden></p>
              </div>
            </div>
            <div class="reservation-grid reservation-contact">
              <div class="reservation-field reservation-wide">
                <label for="reservation-name">Naam *</label>
                <input id="reservation-name" name="name" type="text" required maxlength="120" autocomplete="name" aria-describedby="name-error" />
                <p id="name-error" class="field-error" data-error-for="name" hidden></p>
              </div>
              <div class="reservation-field">
                <label for="reservation-phone">Telefoonnummer *</label>
                <input id="reservation-phone" name="phone" type="tel" required maxlength="32" autocomplete="tel" aria-describedby="phone-error" />
                <p id="phone-error" class="field-error" data-error-for="phone" hidden></p>
              </div>
              <div class="reservation-field">
                <label for="reservation-email">E-mailadres <span class="field-optional">(optioneel)</span></label>
                <input id="reservation-email" name="email" type="email" maxlength="254" autocomplete="email" aria-describedby="email-error" />
                <p id="email-error" class="field-error" data-error-for="email" hidden></p>
              </div>
              <div class="reservation-field reservation-wide">
                <label for="reservation-message">Opmerking <span class="field-optional">(optioneel)</span></label>
                <textarea id="reservation-message" name="message" rows="4" maxlength="1000" aria-describedby="reservation-message-help message-error"></textarea>
                <p id="reservation-message-help" class="field-help">Bijvoorbeeld een vraag of een verzoek om een kinderstoel. Maximaal 1000 tekens.</p>
                <p id="message-error" class="field-error" data-error-for="message" hidden></p>
              </div>
            </div>
            <div hidden aria-hidden="true">
              <label for="reservation-contact-url">Laat dit veld leeg</label>
              <input id="reservation-contact-url" type="text" name="contact_url" tabindex="-1" autocomplete="off" />
            </div>
            <p class="reservation-privacy">Je gegevens worden alleen gebruikt om je reserveringsaanvraag te behandelen. Lees meer in ons <a href="/privacy">privacybeleid</a>.</p>
            <button class="button button-primary" type="submit" data-submit>Verstuur aanvraag</button>
          </fieldset>
        </form>
        <noscript><p class="reservation-note">Het formulier heeft JavaScript nodig. Stuur ons een <a href={site.whatsappHref}>WhatsApp-bericht</a> als je het formulier niet kunt gebruiken. Ons telefoonnummer is {site.phone}. Je reservering is pas definitief na bevestiging door Turuncu.</p></noscript>
        <section class="reservation-success" data-reservation-success role="status" aria-labelledby="reservation-success-title" tabindex="-1" hidden>
          <h2 id="reservation-success-title">Reserveringsaanvraag ontvangen</h2>
          <p>Bedankt! We hebben je aanvraag ontvangen. Je reservering is pas definitief nadat Turuncu deze heeft bevestigd.</p>
          <dl class="reservation-summary">
            <div><dt>Datum</dt><dd data-summary-date></dd></div>
            <div><dt>Gewenste tijd</dt><dd data-summary-time></dd></div>
            <div><dt>Aantal personen</dt><dd data-summary-guests></dd></div>
          </dl>
          <button class="button button-secondary" type="button" data-new-request>Nieuwe aanvraag</button>
        </section>
      </div>
      <aside class="reservation-note" aria-labelledby="reservation-note-title">
        <h2 id="reservation-note-title">Goed om te weten</h2>
        <p>We zijn open van dinsdag t/m zaterdag, van 10:00 tot 16:30. Je gekozen datum en tijd zijn een verzoek. Wacht de bevestiging van Turuncu af voordat je uitgaat van een gereserveerde tafel.</p>
      </aside>
      <section class="reservation-alternatives" aria-labelledby="reservation-contact-title">
        <h2 id="reservation-contact-title">Vragen over je reservering?</h2>
        <p>Stuur ons een WhatsApp-bericht.</p>
        <div class="button-group">
          <a class="button button-secondary" href={site.whatsappHref}>WhatsApp</a>
        </div>
        <a class="reservation-details reservation-phone" href={site.phoneHref}>{site.phone}</a>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { initReservationForm } from '../scripts/reservation-form';
  const widget = document.querySelector<HTMLElement>('[data-reservation-widget]');
  if (widget) initReservationForm(widget);
</script>

<style>
  .reservation-container { max-width: 48rem; }
  .reservation-intro { display: grid; gap: var(--space-3); margin-bottom: var(--space-4); }
  .reservation-intro .eyebrow { margin: 0; }
  fieldset { min-inline-size: 0; margin: 0; padding: 0; border: 0; }
  .form-required, .field-help, .field-optional, .reservation-privacy, .reservation-details { color: var(--color-muted); font-size: var(--text-small); }
  .form-required { margin-bottom: var(--space-3); }
  .reservation-grid { display: grid; gap: var(--space-3); }
  .reservation-contact { margin-top: var(--space-3); }
  .reservation-field { min-width: 0; }
  label { display: block; margin-bottom: 0.375rem; font-weight: 600; }
  .field-optional { font-weight: 400; }
  input, select, textarea {
    display: block; width: 100%; min-width: 0; max-width: 100%; min-height: 48px;
    padding: 0.75rem; border: 1px solid var(--color-muted); border-radius: var(--radius-small);
    background: var(--color-card); color: var(--color-text); font: inherit; line-height: 1.4;
  }
  textarea { resize: vertical; }
  input, select, textarea, .form-error, .reservation-success { scroll-margin-top: var(--header-clearance); }
  [aria-invalid='true'] { border: 2px solid var(--color-primary-dark); }
  .field-help, .field-error { margin-top: 0.375rem; overflow-wrap: anywhere; }
  .field-error, .form-error { color: var(--color-primary-dark); font-weight: 600; }
  .form-error { padding: var(--space-2); margin-bottom: var(--space-3); border-left: 3px solid currentColor; background: var(--color-surface); }
  .reservation-privacy { margin-block: var(--space-3) var(--space-2); }
  button { cursor: pointer; }
  button:disabled { opacity: 0.7; cursor: wait; }
  .reservation-note, .reservation-alternatives { margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
  .reservation-note h2, .reservation-alternatives h2, .reservation-success h2 { font-size: clamp(1.5rem, 4vw, 2rem); margin-bottom: var(--space-2); }
  .reservation-details { margin-top: var(--space-3); }
  .reservation-phone { display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }
  .reservation-alternatives .button-group { margin-top: var(--space-2); }
  .reservation-success { padding: var(--space-3); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-small); }
  .reservation-success h2 { overflow-wrap: anywhere; }
  .reservation-summary { margin-block: var(--space-3); }
  .reservation-summary div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-1) var(--space-2); }
  .reservation-summary dd { margin: 0; font-weight: 600; }
  @media (min-width: 36rem) {
    .reservation-contact { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reservation-wide { grid-column: 1 / -1; }
    .reservation-visit { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
