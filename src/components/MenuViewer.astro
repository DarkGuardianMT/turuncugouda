<dialog id="menu-viewer" class="menu-viewer" aria-labelledby="menu-viewer-title" aria-describedby="menu-viewer-help">
  <div class="menu-viewer-shell">
    <header class="menu-viewer-header">
      <h2 id="menu-viewer-title">Menukaart <span data-menu-count aria-live="polite" aria-atomic="true">1 / 2</span></h2>
      <button type="button" data-menu-close autofocus aria-label="Sluit menukaart">Sluiten <span aria-hidden="true">×</span></button>
    </header>
    <div class="menu-viewer-stage" tabindex="0" role="region" aria-label="Vergrote menukaart" aria-busy="false" data-menu-stage>
      <div class="menu-viewer-canvas" data-menu-canvas><img alt="" class="menu-viewer-image" decoding="async" draggable="false" data-menu-image /></div>
      <p data-menu-error hidden role="alert">De menukaart kon niet worden geladen. Probeer de andere menukaart of bekijk de tekstversie.</p>
    </div>
    <footer class="menu-viewer-footer">
      <div class="menu-viewer-tools">
        <div role="group" aria-label="Menukaarten" class="menu-viewer-controls">
          <button type="button" data-menu-previous aria-label="Vorige menukaart"><span aria-hidden="true">←</span></button>
          <button type="button" data-menu-next aria-label="Volgende menukaart"><span aria-hidden="true">→</span></button>
        </div>
        <div role="group" aria-label="Zoom" class="menu-viewer-controls">
          <button type="button" data-menu-zoom-out aria-label="Uitzoomen"><span aria-hidden="true">−</span></button>
          <output data-menu-zoom aria-live="polite" aria-label="Zoomniveau">100%</output>
          <button type="button" data-menu-zoom-in aria-label="Inzoomen"><span aria-hidden="true">+</span></button>
          <button type="button" data-menu-reset aria-label="Zoom herstellen">Passend</button>
        </div>
      </div>
      <p id="menu-viewer-help">Zoom met + en −. Sleep of veeg om te verplaatsen.<span class="sr-only"> Pijltjes links en rechts wisselen van menukaart. Shift met pijltjes verplaatst de ingezoomde kaart. 0 herstelt de zoom. Escape sluit de menukaart.</span></p>
    </footer>
  </div>
</dialog>

<script>
  import { initMenuViewer } from '../scripts/menu-viewer';
  initMenuViewer();
</script>

<style>
  .menu-viewer {
    position: fixed; inset: 0; width: 100%; max-width: none; height: 100dvh; max-height: none;
    margin: 0; padding: max(0.75rem, env(safe-area-inset-top)) max(0.75rem, env(safe-area-inset-right)) max(0.75rem, env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
    border: 0; background: var(--color-background); color: var(--color-text);
  }
  .menu-viewer::backdrop { background: rgb(52 40 31 / 85%); }
  .menu-viewer-shell { max-width: 90rem; height: 100%; margin-inline: auto; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; gap: var(--space-1); }
  .menu-viewer-header, .menu-viewer-tools, .menu-viewer-controls { display: flex; align-items: center; gap: var(--space-1); }
  .menu-viewer-header, .menu-viewer-tools { justify-content: space-between; }
  .menu-viewer-header h2 { font-size: clamp(1.125rem, 3vw, 1.5rem); letter-spacing: -0.02em; }
  [data-menu-count] { margin-left: var(--space-1); font: 400 var(--text-small) var(--font-body); color: var(--color-muted); }
  .menu-viewer button {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-1);
    min-width: 44px; min-height: 44px; padding: 0.5rem; border: 1px solid var(--color-border);
    border-radius: var(--radius-small); background: var(--color-surface); color: var(--color-text); cursor: pointer;
  }
  .menu-viewer button:hover { border-color: var(--color-primary-dark); color: var(--color-primary-dark); }
  .menu-viewer button:disabled { opacity: 0.45; cursor: default; }
  .menu-viewer-stage {
    min-width: 0; min-height: 0; overflow: auto; overscroll-behavior: contain;
    background: var(--color-footer); border-radius: var(--radius-small); touch-action: pan-x pan-y;
  }
  .menu-viewer-stage:focus-visible { outline-offset: -3px; }
  .menu-viewer-stage[data-zoomed='true'] { cursor: grab; }
  .menu-viewer-stage[data-dragging='true'] { cursor: grabbing; }
  .menu-viewer-canvas { display: grid; place-items: center; min-width: 100%; min-height: 100%; }
  .menu-viewer-image { max-width: none; user-select: none; -webkit-user-drag: none; }
  .menu-viewer-stage[aria-busy='true'] .menu-viewer-image { visibility: hidden; }
  [data-menu-error] { padding: var(--space-3); }
  .menu-viewer-controls output { min-width: 3rem; text-align: center; font-size: var(--text-small); font-variant-numeric: tabular-nums; }
  .menu-viewer-footer p { margin-top: 0.25rem; font-size: 0.75rem; color: var(--color-muted); }
  @media (max-width: 22rem) { .menu-viewer-tools { flex-wrap: wrap; justify-content: center; } }
</style>
