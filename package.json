{
  "name": "turuncugouda",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "reservations:cleanup": "node --env-file-if-exists=.env --experimental-strip-types scripts/cleanup-reservations.mjs",
    "admin:hash-password": "node scripts/admin-hash-password.mjs",
    "test:admin-integration": "node --env-file-if-exists=.env scripts/verify-admin.mjs",
    "test:retention-integration": "node --env-file-if-exists=.env --experimental-strip-types scripts/verify-retention.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.8",
    "astro": "^7.3.6",
    "mysql2": "^3.24.6"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
