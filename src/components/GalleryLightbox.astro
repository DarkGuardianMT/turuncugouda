<dialog id="gallery-lightbox" class="gallery-lightbox" aria-labelledby="lightbox-title" aria-describedby="lightbox-description">
  <div class="lightbox-content">
    <button type="button" class="lightbox-control" data-lightbox-close autofocus aria-label="Sluit vergrote foto">Sluiten <span aria-hidden="true">×</span></button>
    <div class="lightbox-stage" aria-busy="false">
      <img class="lightbox-image" alt="" decoding="async" />
      <p class="lightbox-message" hidden>De foto kon niet worden geladen. Probeer een andere foto.</p>
    </div>
    <div class="lightbox-footer">
      <div class="lightbox-caption" aria-live="polite" aria-atomic="true">
        <h2 id="lightbox-title"></h2>
        <p id="lightbox-description"></p>
        <span class="sr-only" data-lightbox-announcement></span>
      </div>
      <p class="lightbox-count" data-lightbox-count></p>
    </div>
    <div class="lightbox-navigation" role="group" aria-label="Fotonavigatie">
      <button type="button" class="lightbox-control" data-lightbox-previous aria-label="Vorige foto"><span aria-hidden="true">←</span></button>
      <button type="button" class="lightbox-control" data-lightbox-next aria-label="Volgende foto"><span aria-hidden="true">→</span></button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#gallery-lightbox');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-image]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-category]'));
  const filterBar = document.querySelector<HTMLElement>('[data-gallery-filters]');
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]'));
  const results = document.querySelector<HTMLElement>('[data-gallery-results]');

  if (filterBar) {
    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        if (dialog?.open) return;
        const category = filter.dataset.galleryFilter;
        cards.forEach((card) => {
          card.hidden = Boolean(category && card.dataset.galleryCategory !== category);
        });
        filters.forEach((button) => button.setAttribute('aria-pressed', String(button === filter)));
        const count = cards.filter((card) => !card.hidden).length;
        if (results) results.textContent = `${count} ${count === 1 ? 'foto' : "foto's"} · ${filter.textContent}`;
      });
    });
    filterBar.hidden = false;
  }

  if (dialog && typeof dialog.showModal === 'function') {
    const image = dialog.querySelector<HTMLImageElement>('.lightbox-image')!;
    const stage = dialog.querySelector<HTMLElement>('.lightbox-stage')!;
    const message = dialog.querySelector<HTMLElement>('.lightbox-message')!;
    const title = dialog.querySelector<HTMLElement>('#lightbox-title')!;
    const description = dialog.querySelector<HTMLElement>('#lightbox-description')!;
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const announcement = dialog.querySelector<HTMLElement>('[data-lightbox-announcement]')!;
    const close = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;
    let current = 0;
    let visibleTriggers: HTMLButtonElement[] = [];
    let opener: HTMLButtonElement | null = null;
    let previousOverflow = '';

    function show(index: number) {
      current = (index + visibleTriggers.length) % visibleTriggers.length;
      const { dataset } = visibleTriggers[current];
      stage.setAttribute('aria-busy', 'true');
      message.hidden = true;
      image.hidden = false;
      image.alt = dataset.galleryAlt!;
      image.width = Number(dataset.galleryWidth);
      image.height = Number(dataset.galleryHeight);
      image.src = dataset.galleryImage!;
      title.textContent = dataset.galleryTitle!;
      description.textContent = dataset.galleryDescription!;
      count.textContent = `${current + 1} / ${visibleTriggers.length}`;
      announcement.textContent = `Foto ${current + 1} van ${visibleTriggers.length}`;
    }

    image.addEventListener('load', () => stage.setAttribute('aria-busy', 'false'));
    image.addEventListener('error', () => {
      stage.setAttribute('aria-busy', 'false');
      image.hidden = true;
      message.hidden = false;
    });

    triggers.forEach((trigger) => {
      trigger.disabled = false;
      trigger.addEventListener('click', () => {
        if (dialog.open) return;
        visibleTriggers = triggers.filter((item) => !item.closest<HTMLElement>('[data-gallery-category]')?.hidden);
        const index = visibleTriggers.indexOf(trigger);
        if (index === -1) return;
        opener = trigger;
        show(index);
        previousOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = 'hidden';
        dialog.showModal();
        close.focus();
      });
    });

    close.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-previous]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + (event.key === 'ArrowLeft' ? -1 : 1));
      }
    });

    // Alleen een volledige klik op de achtergrond sluit de dialoog; slepen vanuit de foto niet.
    let backdropPointerDown = false;
    dialog.addEventListener('pointerdown', (event) => {
      backdropPointerDown = event.target === dialog;
    });
    dialog.addEventListener('click', (event) => {
      if (backdropPointerDown && event.target === dialog) dialog.close();
      backdropPointerDown = false;
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = previousOverflow;
      if (opener && !opener.closest<HTMLElement>('[data-gallery-category]')?.hidden) {
        opener.focus({ preventScroll: true });
      }
    });
  }
</script>

<style>
  .gallery-lightbox {
    --lightbox-top: max(0.75rem, env(safe-area-inset-top));
    --lightbox-right: max(0.75rem, env(safe-area-inset-right));
    --lightbox-bottom: max(0.75rem, env(safe-area-inset-bottom));
    --lightbox-left: max(0.75rem, env(safe-area-inset-left));
    position: fixed; inset: 0;
    width: 100%; max-width: none; height: 100dvh; max-height: none;
    margin: 0; padding: var(--lightbox-top) var(--lightbox-right) var(--lightbox-bottom) var(--lightbox-left); border: 0;
    background: transparent; color: var(--color-card);
  }
  .gallery-lightbox::backdrop { background: rgb(20 15 11 / 94%); }
  .gallery-lightbox[open] { display: grid; place-items: center; }
  .lightbox-content {
    width: min(100%, var(--container-width)); height: 100%; min-height: 0;
    padding-top: 4rem;
    display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: var(--space-2);
  }
  .lightbox-footer { min-height: 7rem; }
  .lightbox-count { margin-top: var(--space-1); color: var(--color-border); font-size: var(--text-small); font-variant-numeric: tabular-nums; }
  .lightbox-control {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-1);
    position: absolute; z-index: 1;
    min-width: 48px; min-height: 48px; padding: 0.5rem 0.875rem;
    border: 1px solid rgb(255 253 250 / 35%); border-radius: var(--radius-small);
    background: rgb(20 15 11 / 90%); color: inherit; cursor: pointer;
  }
  .lightbox-control:hover { background: var(--color-text); }
  .lightbox-control:focus-visible { outline-color: var(--color-card); outline-offset: 3px; }
  [data-lightbox-close] { top: var(--lightbox-top); right: var(--lightbox-right); }
  [data-lightbox-previous], [data-lightbox-next] { top: 50%; transform: translateY(-50%); font-size: 1.5rem; line-height: 1; }
  [data-lightbox-previous] { left: var(--lightbox-left); }
  [data-lightbox-next] { right: var(--lightbox-right); }
  /* De foto bepaalt niet de afmetingen van het podium of de positie van de knoppen. */
  .lightbox-stage { position: relative; min-width: 0; min-height: 0; display: grid; place-items: center; }
  .lightbox-image { position: absolute; inset: 0; margin: auto; width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain; border-radius: var(--radius-small); }
  .lightbox-caption { min-width: 0; }
  .lightbox-caption h2 { font-size: 1.5rem; letter-spacing: -0.02em; }
  .lightbox-caption p { color: var(--color-border); margin-top: 0.375rem; font-size: var(--text-small); }
  .lightbox-navigation { position: absolute; inset: 0; pointer-events: none; }
  .lightbox-navigation .lightbox-control { pointer-events: auto; }
  .lightbox-message { padding: var(--space-4); }
  @media (min-width: 48rem) {
    .lightbox-stage, .lightbox-footer { margin-inline: 4rem; }
  }
</style>
