---
import { Image } from 'astro:assets';
import highTeaImage from '../assets/photos/high-tea-ai.png';
---

<section id="high-tea" class="high-tea-highlight" aria-labelledby="high-tea-title">
  <div class="container high-tea-layout">
    <div class="high-tea-photo">
      <Image src={highTeaImage} alt="Een etagère met zoete en hartige hapjes en thee op tafel"
        width={640} widths={[320, 480, 640, 960, 1200]} format="webp"
        sizes="(min-width: 1248px) 592px, (min-width: 768px) calc((100vw - 64px) / 2), calc(100vw - 48px)"
        loading="lazy" decoding="async" />
    </div>
    <div class="high-tea-content">
      <p class="high-tea-label">HIGH TEA</p>
      <h2 id="high-tea-title">High Tea bij Turuncu</h2>
      <ul class="high-tea-details">
        <li>Vanaf 2 personen</li>
        <li>Reserveer minimaal 48 uur van tevoren</li>
      </ul>
      <a class="button high-tea-action" href="/reserveren">High Tea reserveren</a>
    </div>
  </div>
</section>

<style>
  .high-tea-highlight {
    --high-tea-background: #2b1d17;
    padding-top: var(--space-5);
    scroll-margin-top: var(--header-clearance);
  }
  .high-tea-layout { display: grid; background: var(--high-tea-background); color: var(--color-background); }
  .high-tea-photo { position: relative; min-width: 0; aspect-ratio: 3 / 2; overflow: hidden; }
  .high-tea-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 65% 25%; }
  .high-tea-content { min-width: 0; padding: var(--space-4) var(--space-3); align-self: center; }
  .high-tea-label { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-2); font-size: var(--text-small); font-weight: 600; letter-spacing: 0.12em; }
  .high-tea-label::before { content: ''; width: var(--space-4); height: 2px; background: var(--color-primary); }
  h2 { max-width: 10em; font-size: clamp(2rem, 3.5vw, 3rem); }
  .high-tea-details { display: grid; gap: var(--space-1); margin: var(--space-3) 0 0; padding: 0; list-style: none; }
  .high-tea-action { margin-top: var(--space-4); background: var(--color-background); color: var(--high-tea-background); }
  .high-tea-action:hover { background: var(--color-footer); }
  .high-tea-action:focus-visible { outline-color: var(--color-background); }
  @media (min-width: 48rem) {
    .high-tea-layout { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .high-tea-photo { aspect-ratio: auto; min-height: 26rem; }
    .high-tea-content { padding: var(--space-4); }
  }
  @media (min-width: 64rem) {
    .high-tea-content { padding: var(--space-5); }
  }
</style>
