---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuCategory from '../components/MenuCategory.astro';
import MenuArtwork from '../components/MenuArtwork.astro';
import { menu } from '../data/menu';
import { site } from '../data/site';
---

<BaseLayout title={`Menu | ${site.name}`} description="Bekijk het menu van Turuncu Café en Bakkerij in Gouda met ontbijt, lunch, koffie, thee, börek, zoet en meer." canonicalPath="/menu">
  <main id="main-content" class="menu-page section" tabindex="-1">
    <div class="container">
      <header class="menu-introduction">
        <h1>Onze menukaart</h1>
      </header>
      <MenuArtwork />
      <details class="menu-text" id="menu-tekst">
        <summary>Menukaart als tekst bekijken</summary>
        <div class="menu-text-content">
      <nav id="menu-categorieen" class="menu-categories" aria-label="Menucategorieën" tabindex="-1">
        <ul>{menu.map((group) => <li><a href={`#${group.id}`}>{group.name}</a></li>)}</ul>
      </nav>
      {menu.map((group) => (
        <section class:list={['menu-group', { 'menu-group-single': group.categories.length === 1 }]} id={group.id} aria-labelledby={`${group.id}-heading`}>
          <h2 id={`${group.id}-heading`}>{group.name}</h2>
          <div class="menu-category-grid">
            {group.categories.map((category) => (
              <MenuCategory category={category} showHeading={category.name !== group.name} />
            ))}
          </div>
          <p class="menu-return"><a class="text-link" href="#menu-categorieen">Naar categorieën <span aria-hidden="true">↑</span></a></p>
        </section>
      ))}
        </div>
      </details>
      <aside class="menu-contact" aria-labelledby="menu-contact-heading">
        <h2 id="menu-contact-heading">Een vraag of reserveren?</h2>
        <p>Heb je een allergie? Meld het ons.</p>
        <a class="text-link" href="/#contact">Neem contact op <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .menu-page { padding-top: var(--space-2); }
  .menu-page > .container { width: min(88rem, calc(100% - 2 * var(--space-3))); }
  .menu-introduction h1 { color: var(--color-primary-dark); font-size: clamp(1.375rem, 2vw, 1.75rem); letter-spacing: -0.02em; text-align: center; }
  .menu-text { border-top: 1px solid var(--color-border); }
  .menu-text summary { padding-block: var(--space-3); color: var(--color-primary-dark); cursor: pointer; font-weight: 600; }
  .menu-text summary::marker { color: var(--color-primary-dark); }
  .menu-text-content { padding-bottom: var(--space-3); }
  .menu-categories { margin-block: var(--space-4) var(--space-5); scroll-margin-top: var(--header-clearance); }
  .menu-categories ul { display: flex; flex-wrap: wrap; gap: var(--space-1); list-style: none; padding: 0; margin: 0; }
  .menu-categories a { display: inline-flex; align-items: center; min-height: 44px; padding: 0.5rem 0.875rem; border: 1px solid var(--color-border); border-radius: var(--radius-small); text-decoration: none; }
  .menu-categories a:hover { color: var(--color-primary-dark); border-color: var(--color-primary-dark); text-decoration: underline; }
  .menu-group { padding-block: var(--space-4); border-top: 1px solid var(--color-border); scroll-margin-top: var(--header-clearance); }
  .menu-group > h2 { margin-bottom: var(--space-3); }
  .menu-category-grid { display: grid; gap: var(--space-4); }
  .menu-group-single > h2, .menu-group-single .menu-category-grid, .menu-group-single .menu-return { max-width: 52rem; margin-inline: auto; }
  .menu-group-single .menu-category-grid { grid-template-columns: minmax(0, 1fr); }
  .menu-return { margin-top: var(--space-3); }
  .menu-contact { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
  .menu-contact h2 { margin-bottom: var(--space-2); }
  @media (min-width: 48rem) {
    .menu-page > .container { width: min(88rem, calc(100% - 2 * var(--space-4))); }
    .menu-category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-5); }
  }
</style>
