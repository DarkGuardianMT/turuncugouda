---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import Section from '../components/Section.astro';
---

<BaseLayout title={site.name}>
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Turuncu · Gouda</p>
          <h1>Turuncu Café<br />en Bakkerij</h1>
          <p class="hero-description">{site.placeholderMessage}</p>
          <div class="button-group">
            <a class="button button-primary" href="/reserveren">Reserveer</a>
            <a class="button button-secondary" href="/#menu">Bekijk het menu <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-visual photo-placeholder"><span>Nieuwe fotografie volgt</span></div>
      </div>
    </section>

    <Section id="menu" title="Menu & highlights" eyebrow="Op het menu" tone="surface">
      <div class="split-content">
        <p class="intro">Hier komt straks het menu van Turuncu.</p>
        <div class="content-panel"><p class="placeholder-label">Menu in voorbereiding</p><p>Het aanbod en de menukaart worden later toegevoegd.</p></div>
      </div>
    </Section>

    <Section id="over-ons" title="Over ons" eyebrow="Turuncu">
      <div class="split-content">
        <div class="about-visual photo-placeholder"><span>Foto volgt</span></div>
        <p class="intro">Het verhaal van Turuncu krijgt hier binnenkort een plek.</p>
      </div>
    </Section>

    <Section title="Een kijkje bij Turuncu" eyebrow="Galerij" tone="surface">
      <div class="section-toolbar"><p>Foto’s worden later toegevoegd.</p><a class="text-link" href="/galerij">Naar de galerij <span aria-hidden="true">↗</span></a></div>
      <div class="gallery-grid" role="group" aria-label="Voorbeeldruimte voor toekomstige foto’s">
        {[1, 2, 3].map(() => <div class="gallery-card photo-placeholder"><span>Foto volgt</span></div>)}
      </div>
    </Section>

    <Section title="Nog meer bij Turuncu" eyebrow="Binnenkort">
      <div class="content-panel special-panel"><p>Deze ruimte is gereserveerd voor extra aanbod. De invulling volgt later.</p></div>
    </Section>

    <Section title="Volg Turuncu" eyebrow="Instagram" tone="surface">
      <p class="intro">De Instagram-link en beelden worden later toegevoegd.</p>
    </Section>

    <Section id="bezoek" title="Bezoek Turuncu" eyebrow="Tot binnenkort">
      <div class="visit-grid">
        <div class="content-panel"><h3>Openingstijden</h3><p>Bevestigde openingstijden volgen.</p></div>
        <div class="content-panel"><h3>Adres & locatie</h3><p>Adres en route-informatie volgen.</p></div>
        <div class="content-panel"><h3>Contact</h3><p>Contactgegevens volgen.</p></div>
        <div class="content-panel map-placeholder"><h3>Vind ons</h3><p>Een kaart of routelink wordt later toegevoegd.</p></div>
      </div>
    </Section>
  </main>
</BaseLayout>
