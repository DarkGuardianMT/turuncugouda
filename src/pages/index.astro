---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, openingHours } from '../data/site';
import Section from '../components/Section.astro';
import { Image } from 'astro:assets';
import PhotoGrid from '../components/PhotoGrid.astro';
import { photos, highlights, galleryPreview } from '../data/gallery';
---

<BaseLayout title={site.name}>
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Turuncu · Gouda</p>
          <h1>Turuncu Café<br />en Bakkerij</h1>
          <p class="hero-description">{site.subtitle}</p>
          <div class="button-group">
            <a class="button button-primary" href="/galerij">Bekijk de galerij</a>
            <a class="button button-secondary" href="/#contact">Bezoek ons <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <Image class="hero-visual" src={photos.hero.image} alt={photos.hero.alt}
          width={700} widths={[320, 480, 700, 1050, 1400]}
          sizes="(min-width: 1248px) 541px, (min-width: 768px) calc((100vw - 112px) / 2.1), calc(100vw - 48px)"
          loading="eager" fetchpriority="high" />
      </div>
    </section>

    <Section id="menu" title="Café, bakkerij & lunch" eyebrow="Bij Turuncu" tone="surface">
      <div class="highlights-grid">
        {highlights.map(({ title, photo }) => (
          <article class="highlight">
            <Image src={photo.image} alt={photo.alt} width={Math.min(640, photo.image.width)}
              widths={[320, 480, 640, 810].filter((width) => width <= photo.image.width)}
              sizes="(min-width: 1248px) 379px, (min-width: 768px) calc((100vw - 112px) / 3), (min-width: 576px) calc((100vw - 96px) / 3), calc(100vw - 48px)"
              style={{ objectPosition: title === 'Café' ? '50% 100%' : photo.objectPosition ?? 'center' }}
              loading="lazy" />
            <h3>{title}</h3>
          </article>
        ))}
      </div>
      <div class="button-group"><a class="button button-primary" href="/menu">Bekijk het menu</a></div>
    </Section>

    <Section id="over-ons" title="Over Turuncu" eyebrow="Turuncu">
      <div class="split-content">
        <Image class="about-visual" src={photos.atmosphere.image} alt={photos.atmosphere.alt}
          width={720} widths={[320, 480, 720, 1080]}
          sizes="(min-width: 1248px) 568px, (min-width: 768px) calc((100vw - 112px) / 2), calc(100vw - 48px)"
          loading="lazy" />
        <div class="about-copy">
          <p class="intro">Bij Turuncu komen Turkse gastvrijheid en Nederlandse gezelligheid samen.</p>
          <p>Een warme plek in Gouda voor koffie, iets lekkers uit de bakkerij of een ontspannen lunch. Ook gezinnen en kinderen zijn van harte welkom.</p>
        </div>
      </div>
    </Section>

    <Section title="Een kijkje bij Turuncu" eyebrow="Galerij" tone="surface">
      <div class="section-toolbar"><p>Een impressie van Turuncu Café en Bakkerij.</p><a class="text-link" href="/galerij">Bekijk de galerij <span aria-hidden="true">↗</span></a></div>
      <PhotoGrid photos={galleryPreview} preview />
    </Section>

    <Section id="contact" title="Contact" eyebrow="In Winkelcentrum Bloemendaal">
      <div class="contact-grid">
        <div class="contact-details">
          <h3>Contactgegevens</h3>
          <address>
            <strong>{site.name}</strong><br />
            {site.address}<br />{site.postalAddress}<br />{site.location}
          </address>
          <a class="text-link" href={site.phoneHref}>{site.phone}</a>
          <div class="social-links">
            <a href={site.instagram.href}>Instagram: {site.instagram.handle}</a>
            <a href={site.tiktok.href}>TikTok: {site.tiktok.handle}</a>
          </div>
        </div>
        <div class="contact-hours">
          <h3>Openingstijden</h3>
          <dl class="opening-hours">
            {openingHours.map(({ days, hours }) => <div><dt>{days}</dt><dd>{hours}</dd></div>)}
          </dl>
        </div>
        <div class="reservation-guidance">
          <h3>Reserveren</h3>
          <p>{site.reservationMessage}</p>
          <div class="button-group">
            <a class="button button-primary" href={site.phoneHref}>Bel ons</a>
            <a class="button button-secondary" href={site.instagram.href}>Instagram</a>
            <a class="button button-secondary" href={site.directionsHref}>Route <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
