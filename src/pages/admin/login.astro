---
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = false;
if (Astro.locals.adminSession) return Astro.redirect('/admin/reservations', 303);
const notice = Astro.url.searchParams.get('notice');
const message = notice === 'invalid' ? 'De inloggegevens zijn niet correct.'
  : notice === 'limited' ? 'Te veel inlogpogingen. Probeer het over 15 minuten opnieuw.' : '';
---
<AdminLayout title="Inloggen">
  <section class="admin-login admin-panel" aria-labelledby="login-title">
    <h1 id="login-title">Beheer</h1>
    <p>Log in om reserveringsaanvragen te bekijken.</p>
    {message && <p class="admin-notice" role="alert">{message}</p>}
    <form action="/admin/auth/login" method="post" class="admin-form">
      <div><label for="username">Gebruikersnaam</label><input id="username" name="username" required maxlength="120" autocomplete="username" autocapitalize="none" spellcheck="false" /></div>
      <div><label for="password">Wachtwoord</label><input id="password" name="password" type="password" required maxlength="1024" autocomplete="current-password" /></div>
      <button class="button button-primary" type="submit">Inloggen</button>
    </form>
  </section>
</AdminLayout>
