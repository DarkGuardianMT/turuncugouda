---
import { tickerProducts } from '../data/productTicker';
---

<section class="product-ticker" aria-label="Uit ons menu">
  <p class="sr-only">{tickerProducts.join(', ')}.</p>
  <div class="container ticker-inner">
    <input id="ticker-pause" class="ticker-pause sr-only" type="checkbox" aria-label="Productstrook pauzeren" />
    <label class="ticker-toggle" for="ticker-pause">
      <span class="ticker-running">Pauzeer <span aria-hidden="true">Ⅱ</span></span>
      <span class="ticker-paused">Hervat <span aria-hidden="true">▷</span></span>
    </label>
    <div class="ticker-viewport" tabindex="0" role="group" aria-label="Productnamen uit het menu">
      <div class="ticker-track" aria-hidden="true">
        {[0, 1].map((copy) => (
          <div class="ticker-group" data-ticker-copy={copy}>
            {tickerProducts.map((name) => (
              <span class="ticker-item">{name}<span class="ticker-separator">✦</span></span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .product-ticker {
    padding-block: var(--space-1);
    background: var(--color-primary-dark); color: var(--color-background);
  }
  .ticker-inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-2); }
  .ticker-viewport {
    grid-column: 1 / -1; grid-row: 1; min-width: 0;
    overflow-x: auto; scrollbar-width: thin; padding-block: var(--space-1);
  }
  .ticker-track { display: flex; width: max-content; }
  .ticker-group {
    display: flex; align-items: center; flex: 0 0 auto;
    gap: var(--space-4); padding-inline-end: var(--space-4);
  }
  .ticker-group + .ticker-group { display: none; }
  .ticker-item {
    display: inline-flex; align-items: center; gap: var(--space-4); white-space: nowrap;
    font-family: var(--font-display); font-size: clamp(1.125rem, 2vw, 1.75rem);
    font-weight: 400; line-height: 1.2; letter-spacing: 0.035em; text-transform: uppercase;
  }
  .ticker-separator { color: inherit; opacity: 0.85; font-size: 0.5em; }
  .ticker-pause, .ticker-toggle, .ticker-paused { display: none; }
  .ticker-toggle {
    grid-column: 2; grid-row: 1; align-items: center; justify-content: center;
    min-height: 44px; padding-inline: var(--space-1);
    color: inherit; font-size: 0.75rem; cursor: pointer; white-space: nowrap;
  }
  .ticker-pause:focus-visible + .ticker-toggle { outline: 3px solid currentColor; outline-offset: 3px; }
  .ticker-viewport:focus-visible { outline-color: currentColor; }
  .ticker-pause:checked + .ticker-toggle .ticker-running { display: none; }
  .ticker-pause:checked + .ticker-toggle .ticker-paused { display: inline; }
  .ticker-pause:checked ~ .ticker-viewport .ticker-track,
  .ticker-viewport:hover .ticker-track,
  .ticker-viewport:focus-within .ticker-track { animation-play-state: paused; }
  @keyframes ticker-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: no-preference) {
    .ticker-viewport { grid-column: 1; overflow: hidden; }
    .ticker-group + .ticker-group { display: flex; }
    .ticker-track { animation: ticker-scroll 70s linear infinite; }
    .ticker-pause { display: block; }
    .ticker-toggle { display: inline-flex; }
  }
</style>
