---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Reserveren | ${site.name}`}>
  <main id="main-content" class="route-placeholder section" tabindex="-1">
    <div class="container">
      <p class="eyebrow">Turuncu</p>
      <h1>Reserveren</h1>
      <p class="intro">Online reserveren via deze website is nog niet beschikbaar.</p>
      <a class="button button-secondary" href="/">Terug naar de homepage</a>
    </div>
  </main>
</BaseLayout>
