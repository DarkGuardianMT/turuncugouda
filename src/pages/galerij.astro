---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Galerij | ${site.name}`}>
  <main id="main-content" class="route-placeholder section" tabindex="-1">
    <div class="container">
      <p class="eyebrow">Een kijkje bij Turuncu</p>
      <h1>Galerij</h1>
      <p class="intro">De galerij is in voorbereiding. Foto’s worden later toegevoegd.</p>
      <a class="button button-secondary" href="/">Terug naar de homepage</a>
    </div>
  </main>
</BaseLayout>
