---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { photos } from '../data/gallery';
import { canonicalUrl, serializeJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | null;
  socialImage?: { src: string; alt: string; width?: number; height?: number };
  robots?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, canonicalPath = Astro.url.pathname, socialImage, robots, structuredData } = Astro.props;
if (!Astro.site) throw new Error('Configure the canonical production site in astro.config.mjs.');
const canonical = canonicalPath === null ? undefined : canonicalUrl(canonicalPath, Astro.site);
const defaultImage = await getImage({ src: photos.hero.image, width: Math.min(1200, photos.hero.image.width), format: 'jpeg', quality: 85 });
const image = socialImage ?? { src: defaultImage.src, alt: photos.hero.alt,
  width: defaultImage.attributes.width, height: defaultImage.attributes.height };
const imageUrl = new URL(image.src, Astro.site).href;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" type="image/png" sizes="180x180" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={image.alt} />
    {image.width && <meta property="og:image:width" content={image.width} />}
    {image.height && <meta property="og:image:height" content={image.height} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    {structuredData && <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Naar de inhoud</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
