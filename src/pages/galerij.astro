---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import PhotoGrid from '../components/PhotoGrid.astro';
import { gallery } from '../data/gallery';
---

<BaseLayout title={`Galerij | ${site.name}`}>
  <main id="main-content" class="gallery-page section" tabindex="-1">
    <div class="container">
      <p class="eyebrow">Een kijkje bij Turuncu</p>
      <h1>Galerij</h1>
      <p class="intro">Een impressie van Turuncu Café en Bakkerij.</p>
      <PhotoGrid photos={gallery} varied />
    </div>
  </main>
</BaseLayout>
