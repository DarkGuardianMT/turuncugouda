---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, openingHours } from '../data/site';
import Section from '../components/Section.astro';
import { Image } from 'astro:assets';
import PhotoGrid from '../components/PhotoGrid.astro';
import { photos } from '../data/gallery';
import { favorites } from '../data/favorites';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import ProductTicker from '../components/ProductTicker.astro';
import { businessStructuredData } from '../lib/seo';
if (!Astro.site) throw new Error('Missing canonical site configuration.');
const favoritePhotos = favorites.flatMap(({ photos: groupPhotos }) => groupPhotos);
---

<BaseLayout title={`${site.name} | ${site.city}`} description="Turuncu Café en Bakkerij in Winkelcentrum Bloemendaal in Gouda. Geniet van koffie, Turkse bakkerijproducten, ontbijt, lunch en meer." canonicalPath="/" structuredData={businessStructuredData(Astro.site)}>
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Turuncu · Gouda</p>
          <h1>Turuncu Café<br />en Bakkerij</h1>
          <p class="hero-description">{site.subtitle}</p>
          <div class="button-group">
            <a class="button button-primary" href="#favorieten">Ontdek onze favorieten</a>
            <a class="button button-secondary" href="/#contact">Bezoek ons <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <Image class="hero-visual" src={photos.hero.image} alt={photos.hero.alt}
          width={700} widths={[320, 480, 700, 1050, 1400]}
          sizes="(min-width: 1248px) 541px, (min-width: 768px) calc((100vw - 112px) / 2.1), calc(100vw - 48px)"
          loading="eager" fetchpriority="high" />
      </div>
    </section>

    <ProductTicker />

    <section id="favorieten" class="favorites-preview section-surface" aria-labelledby="favorites-title">
      <div class="container">
        <h2 id="favorites-title" class="sr-only">Onze favorieten</h2>
        <PhotoGrid photos={favoritePhotos} interactive favorites id="favorites-grid" />
        <div class="favorites-action"><a class="button button-primary" href="/galerij">Ontdek de galerij <span aria-hidden="true">↗</span></a></div>
        <GalleryLightbox />
      </div>
    </section>

    <Section id="over-ons" title="Over Turuncu" eyebrow="Turuncu">
      <div class="split-content">
        <Image class="about-visual" src={photos.atmosphere.image} alt={photos.atmosphere.alt}
          width={720} widths={[320, 480, 720, 1080]}
          sizes="(min-width: 1248px) 568px, (min-width: 768px) calc((100vw - 112px) / 2), calc(100vw - 48px)"
          loading="lazy" />
        <div class="about-copy">
          <p class="intro">Bij Turuncu komen Turkse gastvrijheid en Nederlandse gezelligheid samen.</p>
          <p>Een warme plek in Gouda voor koffie, iets lekkers uit de bakkerij of een ontspannen lunch. Ook gezinnen en kinderen zijn van harte welkom.</p>
        </div>
      </div>
    </Section>

    <Section id="contact" title="Contact" eyebrow="In Winkelcentrum Bloemendaal">
      <div class="contact-grid">
        <div class="contact-details">
          <h3>Contactgegevens</h3>
          <address>
            <strong>{site.name}</strong><br />
            {site.address}<br />{site.postalAddress}<br />{site.location}
          </address>
          <a class="text-link" href={site.phoneHref}>{site.phone}</a>
          <div class="social-links">
            <a href={site.instagram.href}>Instagram: {site.instagram.handle}</a>
            <a href={site.tiktok.href}>TikTok: {site.tiktok.handle}</a>
          </div>
        </div>
        <div class="contact-hours">
          <h3>Openingstijden</h3>
          <dl class="opening-hours">
            {openingHours.map(({ days, hours }) => <div><dt>{days}</dt><dd>{hours}</dd></div>)}
          </dl>
        </div>
        <div class="reservation-guidance">
          <h3>Reserveren</h3>
          <p>{site.reservationMessage}</p>
          <div class="button-group">
            <a class="button button-primary" href="/reserveren">Reservering aanvragen</a>
            <a class="button button-secondary" href={site.phoneHref}>Bel ons</a>
            <a class="button button-secondary" href={site.instagram.href}>Instagram</a>
            <a class="button button-secondary" href={site.directionsHref}>Route <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>

<style>
  .favorites-preview {
    padding-block: var(--space-3);
    scroll-margin-top: var(--header-clearance);
  }
  .favorites-preview :global(.favorites-grid) {
    grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-1);
  }
  .favorites-preview :global(.gallery-trigger) {
    aspect-ratio: 8 / 5; min-height: 48px;
    border-radius: calc(var(--radius-small) / 2);
  }
  .favorites-action { display: flex; justify-content: center; margin-top: var(--space-1); }
  .favorites-action .button { min-height: 44px; padding: 0.5rem 1rem; font-size: var(--text-small); }
  @media (min-width: 22.5rem) {
    .favorites-preview :global(.favorites-grid) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 48rem) {
    .favorites-preview { padding-block: var(--space-4); }
    .favorites-preview :global(.favorites-grid) { gap: calc(var(--space-3) / 2); }
  }
  @media (min-width: 64rem) {
    .favorites-preview :global(.favorites-grid) { gap: var(--space-2); }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(#favorieten)) { scroll-behavior: smooth; }
  }
</style>
