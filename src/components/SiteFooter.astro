---
import { site } from '../data/site';
import Brand from './Brand.astro';
import SocialIcon from './SocialIcon.astro';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const footerNavigation = [
  { label: 'Home', href: '/' }, { label: 'Menu', href: '/menu' },
  { label: 'Galerij', href: '/galerij' }, { label: 'Reserveren', href: '/reserveren' },
];
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand"><Brand /></div>
      <nav class="footer-navigation" aria-label="Footernavigatie">
        <h2>Ontdek Turuncu</h2>
        <ul>{footerNavigation.map(({ label, href }) => <li><a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a></li>)}</ul>
      </nav>
      <section class="footer-contact" aria-labelledby="footer-contact-title">
        <h2 id="footer-contact-title">Bezoek & contact</h2>
        <address>{site.address}<br />{site.postalAddress}<br /><span>{site.location}</span></address>
        <div class="footer-direct">
          <a class="footer-whatsapp" href={site.whatsappHref}>WhatsApp <span aria-hidden="true">↗</span></a>
          <a class="footer-phone" href={site.phoneHref}>{site.phone}</a>
        </div>
        <div class="footer-social" role="group" aria-label="Sociale media">
          <a href={site.instagram.href}><SocialIcon platform="instagram" />Instagram</a>
          <a href={site.tiktok.href}><SocialIcon platform="tiktok" />TikTok</a>
        </div>
      </section>
    </div>
    <div class="footer-utility">
      <p>© {year} Turuncu Gouda</p>
      <a href="/privacy" aria-current={pathname === '/privacy' ? 'page' : undefined}>Privacy</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-muted: #d1beac;
    --footer-rule: rgb(246 237 223 / 20%);
    padding-block: var(--space-4) var(--space-2);
    background: var(--color-dark); color: var(--color-background);
    font-size: var(--text-small);
  }
  .footer-grid { display: grid; gap: var(--space-4); align-items: start; }
  .footer-grid > * { min-width: 0; }
  .footer-brand :global(.brand) { flex-direction: row; align-items: center; gap: var(--space-2); }
  .footer-brand :global(.brand-logo) { width: 64px; }
  .footer-brand :global(.brand-subtitle) { color: var(--color-background); font-size: var(--text-small); }
  h2 { margin-bottom: var(--space-1); font-size: 1.375rem; letter-spacing: -0.02em; }
  .footer-navigation ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-2); }
  a { display: inline-flex; align-items: center; gap: var(--space-1); min-height: 44px; max-width: 100%; text-decoration: none; }
  a:hover, a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--color-primary); text-decoration-thickness: 2px; }
  a:focus-visible, .footer-brand :global(.brand:focus-visible) { outline-color: var(--color-background); }
  address { line-height: 1.7; }
  address span { color: var(--footer-muted); }
  .footer-direct { display: flex; flex-wrap: wrap; gap: 0 var(--space-3); margin-top: var(--space-1); }
  .footer-whatsapp { font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-primary); }
  .footer-phone { color: var(--footer-muted); }
  .footer-social { display: flex; flex-wrap: wrap; gap: 0 var(--space-3); }
  .footer-utility { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 var(--space-3); margin-top: var(--space-4); padding-top: var(--space-2); border-top: 1px solid var(--footer-rule); color: var(--footer-muted); }
  @media (min-width: 48rem) {
    .site-footer { padding-top: var(--space-5); }
    .footer-grid { grid-template-columns: 1.15fr 0.75fr 1.35fr; }
    .footer-brand :global(.brand) { flex-direction: column; align-items: flex-start; }
    .footer-navigation ul { grid-template-columns: 1fr; }
  }
  @media (min-width: 64rem) {
    .footer-grid { gap: var(--space-5); }
    .footer-brand :global(.brand) { flex-direction: row; align-items: center; }
    .footer-brand :global(.brand-logo) { width: 72px; }
  }
</style>
