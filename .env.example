# Alleen voorbeelden: vervang deze waarden lokaal of in de hostingomgeving.
# Gebruik nooit deze voorbeeldwaarden als productiegegevens.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=turuncugouda
DB_USER=your_user
DB_PASSWORD=your_password
DB_CONNECTION_LIMIT=5

# Server-only SMTP met directe TLS; vul eigen waarden in (productiepoort: 465).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=reservations@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=reservations@example.com
RESERVATION_NOTIFICATION_TO=notifications@example.com

ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=your_generated_password_hash
ADMIN_SESSION_SECRET=your_random_session_secret

# Server-only: willekeurige base64url-secret van minimaal 32 bytes, gelijk op alle instanties.
RATE_LIMIT_SECRET=your_random_rate_limit_secret

MAINTENANCE_DB_USER=your_maintenance_user
MAINTENANCE_DB_PASSWORD=your_maintenance_password
