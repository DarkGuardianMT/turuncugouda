---
import '../styles/global.css';
import '../styles/admin.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Turuncu beheer</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Naar de inhoud</a>
    <header class="admin-brand container"><a href="/">Turuncu</a><span>Beheer</span></header>
    <main id="main-content" class="admin-main container" tabindex="-1"><slot /></main>
  </body>
</html>
